{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The panel's window, for local content only: IssueRelay's own commands (one allow-<command> entry each, from the app manifest in build.rs) and listening to the app's events (core:event listen and unlisten). Nothing else: no plugin permission and no other core permission; links, folders, notifications, autostart, the command line on PATH and updates go through the commands.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-startup-state",
    "allow-status",
    "allow-list-jobs",
    "allow-job",
    "allow-job-log",
    "allow-issues",
    "allow-pause",
    "allow-resume",
    "allow-poll-now",
    "allow-cancel-job",
    "allow-retry-job",
    "allow-mark-done",
    "allow-bindings",
    "allow-save-binding",
    "allow-remove-binding",
    "allow-projects",
    "allow-labels",
    "allow-settings",
    "allow-save-settings",
    "allow-doctor",
    "allow-linear-login",
    "allow-linear-cancel-login",
    "allow-linear-use-api-key",
    "allow-linear-logout",
    "allow-linear-reconnect",
    "allow-setup-action",
    "allow-control-servers",
    "allow-linear-server-named",
    "allow-open-linear",
    "allow-choose-directory",
    "allow-autostart-enabled",
    "allow-set-autostart",
    "allow-quit",
    "allow-request-quit",
    "allow-cli-on-path",
    "allow-install-cli-on-path",
    "allow-remove-cli-from-path",
    "allow-update-status",
    "allow-check-update",
    "allow-install-update"
  ]
}
